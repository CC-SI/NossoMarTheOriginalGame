  Dialogos:
  - id: pato_professor1
    speaker: Pato Professor
    texto: "Ah, um novo aluno! Estou ansioso para testar seu conhecimento. Estou preparado para fazer três perguntas. Se você acertar pelo menos duas, você será recompensado!"
    pergunta: {fileID: 0}
  - id: player
    speaker: Personagem
    texto: "Eba, adoro ganhar recompensas. Vamos nessa!"
    pergunta: {fileID: 0}
  - id: pergunta
    speaker: 
    texto: 
    pergunta: {fileID: 11400000, guid: 7a58e6bf34091654f9f644c4b866fa7a, type: 2}
  - id: pato_professor2
    speaker: 'Pato Professor '
    texto: "Parabéns!! Você conseguiu acertar as questões! A recompensa sou EU! Irei te dar ótimos conselhos daqui em diante."
    pergunta: {fileID: 11400000, guid: 7a58e6bf34091654f9f644c4b866fa7a, type: 2}
